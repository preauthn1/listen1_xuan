<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is disabled app-wide. mobilecdnbj.kugou.com is the only exception:
  its CDN edge serves a certificate for default.chinanetcenter.com, so HTTPS
  fails hostname verification and the KuGou album/artist/search APIs only
  work over plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">mobilecdnbj.kugou.com</domain>
    </domain-config>
</network-security-config>
